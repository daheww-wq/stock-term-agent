# 이 파일을 복사해 이름을 .env로 바꾸고 값을 채운다. .env는 GitHub에 올리지 않는다.

# Langfuse
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# OpenRouter
OPENROUTER_API_KEY=""

# 에이전트에 쓸 모델 ID
AGENT_MODEL=""

# 채점용 모델 ID
JUDGE_MODEL="openai/gpt-6-sol"

# LLM 호출 간격 (분당 최대 호출 수). OpenRouter 새 계정 한도 20회보다 조금 낮게. 0이면 간격 조절 끔
CALLS_PER_MINUTE="18"
